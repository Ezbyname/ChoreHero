{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*":              ["src/*"],
      "@/components/*":  ["src/components/*"],
      "@/screens/*":     ["src/screens/*"],
      "@/navigation/*":  ["src/navigation/*"],
      "@/theme/*":       ["src/theme/*"],
      "@/content/*":     ["src/content/*"]
    },
    // QA-01 — Runtime Build Identification. Without this, TypeScript's
    // implicit @types auto-inclusion picks up @types/node's ambient
    // globals (process, etc. — already relied on throughout src/) but not
    // its subpath module declarations (e.g. 'child_process', needed by
    // app.config.ts's git-SHA resolution) — confirmed empirically: this
    // one line is what fixes it, isolated by testing with/without it.
    "types": ["node"]
  },
  "exclude": [
    "e2e",
    "playwright.config.ts",
    "node_modules",
    "**/__tests__/**",
    "scripts/test",
    // Deno Edge Function entry points only (npm:/jsr: specifiers, Deno
    // globals, explicit .ts import extensions — none of it resolves under
    // this project's Node-oriented tsconfig). handler.ts files living
    // alongside index.ts are deliberately portable/Deno-free and stay
    // type-checked normally — only the runtime-glue entry point is excluded.
    "supabase/functions/**/index.ts"
  ]
}
